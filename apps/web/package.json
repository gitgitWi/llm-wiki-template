{
  "name": "@llm-wiki/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run index && npm run guard",
    "index": "pagefind --site dist/client --output-subdir _pagefind",
    "guard": "node scripts/leak-guard.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/markdown-satteri": "^0.3.5",
    "astro": "^7.2.2",
    "d3-force": "^3.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.2.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.123.0"
  }
}
