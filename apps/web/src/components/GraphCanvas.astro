---
import type { Graph } from '../lib/wiki';

interface Props {
  /** 인라인할 그래프. ego 그래프처럼 작은 데이터에 쓴다. */
  data?: Graph;
  /** fetch할 그래프 URL. 전역 그래프처럼 큰 데이터에 쓴다. */
  src?: string;
  /** 캔버스 높이 CSS 값. */
  height?: string;
  /** 태그 엣지 on/off 체크박스를 붙일지. */
  toggle?: boolean;
  label?: string;
}

const {
  data,
  src,
  height = 'min(70vh, 34rem)',
  toggle = false,
  label = '문서 연결 그래프',
} = Astro.props;

if (!data && !src) throw new Error('GraphCanvas: data 나 src 중 하나는 있어야 한다.');

// ego 그래프는 인라인한다 — 이웃 수 + 1 노드라 수백 바이트고, 문서마다 JSON 파일을
// 따로 내면 요청 수와 파일 수만 늘고 총량(O(V+E))은 그대로다.
const inline = data ? JSON.stringify(data) : undefined;
const tagEdgeCount = data?.links.filter((link) => link.kind === 'tag').length ?? 0;
---

<figure class="graph" style={`--graph-height: ${height}`}>
  <canvas
    class="graph__canvas"
    role="img"
    aria-label={label}
    data-graph={inline}
    data-graph-src={src}></canvas>

  <figcaption class="graph__caption">
    {
      toggle && (
        <label class="graph__toggle">
          <input type="checkbox" class="graph__tags" checked />
          태그로 이어진 연결도 보기
          {!src && tagEdgeCount > 0 && ` (${tagEdgeCount})`}
        </label>
      )
    }
    <span>노드를 끌어 옮길 수 있다. 클릭하면 해당 문서로 이동한다.</span>
  </figcaption>
</figure>

<style>
  .graph {
    margin: 0;
  }

  .graph__canvas {
    width: 100%;
    height: var(--graph-height);
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    touch-action: none;
    cursor: grab;
  }

  .graph__canvas:active {
    cursor: grabbing;
  }

  .graph__caption {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }

  .graph__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    color: var(--text);
  }
</style>

<script>
  import {
    forceCenter,
    forceCollide,
    forceLink,
    forceManyBody,
    forceSimulation,
    forceX,
    forceY,
  } from 'd3-force';

  type GraphNode = {
    id: string;
    title: string;
    type: string;
    degree: number;
    focus?: boolean;
    x?: number;
    y?: number;
    fx?: number | null;
    fy?: number | null;
    /** 잘라낸 라벨과 그 절반 너비. 충돌 반경과 여백 계산에 쓴다. */
    label?: string;
    labelHalf?: number;
  };
  type GraphEdge = {
    source: GraphNode | string;
    target: GraphNode | string;
    kind: 'link' | 'tag';
    weight: number;
    tags: string[];
  };
  type Graph = { nodes: GraphNode[]; links: GraphEdge[] };

  const LABEL_FONT = '12px system-ui, sans-serif';
  const LABEL_MAX = 18;

  function truncate(value: string) {
    return value.length > LABEL_MAX ? `${value.slice(0, LABEL_MAX - 1)}…` : value;
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('.graph__canvas')) {
    void mount(canvas);
  }

  async function mount(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const graph = await load(canvas);
    if (!graph || graph.nodes.length === 0) return;

    const { nodes } = graph;
    // 시뮬레이션에 넘긴 엣지는 d3 가 source/target 을 노드 객체로 바꿔버린다.
    // 켜고 끄기를 하려면 원본 배열을 따로 들고 있어야 한다.
    const allLinks = graph.links;
    let showTags = true;
    let links = allLinks;

    const css = getComputedStyle(document.documentElement);
    const colors = {
      text: css.getPropertyValue('--text').trim() || '#222',
      muted: css.getPropertyValue('--text-muted').trim() || '#888',
      accent: css.getPropertyValue('--accent').trim() || '#8a5a2b',
      border: css.getPropertyValue('--border').trim() || '#ddd',
    };

    let width = 0;
    let height = 0;
    let hovered: GraphNode | null = null;
    let dragged: GraphNode | null = null;
    let dragMoved = false;

    const radiusOf = (node: GraphNode) =>
      (node.focus ? 7 : 5) + Math.min(node.degree, 6) * 1.6;

    /**
     * 라벨은 노드보다 훨씬 넓다. 충돌 반경을 노드 크기로만 잡으면 원끼리는 안 겹치는데
     * 글자끼리 겹쳐서 두 제목이 뭉개진다. 라벨 절반 너비를 충돌 반경에 반영한다.
     */
    ctx.font = LABEL_FONT;
    for (const node of nodes) {
      node.label = truncate(node.title);
      node.labelHalf = ctx.measureText(node.label).width / 2;
    }

    const collideRadiusOf = (node: GraphNode) =>
      Math.max(radiusOf(node) + 12, (node.labelHalf ?? 0) + 8);

    /** 라벨이 노드 아래에 붙으므로 아래쪽 여백을 더 준다. */
    const PAD = { top: 16, bottom: 26 };
    /** 좌우 여백은 노드마다 다르다 — 긴 라벨은 더 안쪽에 있어야 잘리지 않는다. */
    const padXOf = (node: GraphNode) => Math.max(10, (node.labelHalf ?? 0) + 6);

    const linkForce = forceLink<GraphNode, GraphEdge>(links)
      .id((node) => node.id)
      // 태그 연결은 링크보다 느슨하게 — 추론된 관계를 저자가 직접 이은 것과
      // 같은 거리로 당기면 둘을 구분한 의미가 없어진다.
      .distance((link) => (link.kind === 'tag' ? 150 : 110))
      .strength((link) => (link.kind === 'tag' ? 0.14 : 0.5));

    const simulation = forceSimulation<GraphNode>(nodes)
      .force('link', linkForce)
      .force('charge', forceManyBody().strength(-260).distanceMax(420))
      .force('collide', forceCollide<GraphNode>(collideRadiusOf))
      .on('tick', () => {
        clampToCanvas();
        render();
      });

    /**
     * 반발력만 걸어두면 연결이 없는 노드가 캔버스 밖으로 밀려나 영영 안 보인다.
     * 중심으로 당기는 약한 힘 + 틱마다 경계로 자르기, 둘 다 있어야 한다 — 당기는
     * 힘만으로는 초기 몇 틱 동안 튀어나간 노드를 못 잡는다.
     */
    function clampToCanvas() {
      for (const node of nodes) {
        const r = radiusOf(node);
        const padX = Math.min(padXOf(node), width / 2);
        node.x = Math.max(padX, Math.min(width - padX, node.x ?? width / 2));
        node.y = Math.max(PAD.top + r, Math.min(height - PAD.bottom - r, node.y ?? height / 2));
      }
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      simulation
        .force('center', forceCenter(width / 2, height / 2))
        .force('x', forceX(width / 2).strength(0.05))
        .force('y', forceY(height / 2).strength(0.08))
        .alpha(0.8)
        .restart();
    }

    function render() {
      ctx!.clearRect(0, 0, width, height);

      for (const link of links) {
        const source = link.source as GraphNode;
        const target = link.target as GraphNode;
        if (typeof source !== 'object' || typeof target !== 'object') continue;

        ctx!.save();
        ctx!.strokeStyle = colors.border;
        if (link.kind === 'tag') {
          // 점선 = 태그로 추론된 관계. 실선 = 저자가 직접 이은 링크.
          ctx!.setLineDash([3, 4]);
          ctx!.lineWidth = 1;
        } else {
          ctx!.lineWidth = 1 + Math.min(link.weight - 1, 2) * 0.6;
        }
        ctx!.beginPath();
        ctx!.moveTo(source.x!, source.y!);
        ctx!.lineTo(target.x!, target.y!);
        ctx!.stroke();
        ctx!.restore();
      }

      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'top';
      for (const node of nodes) {
        const active = node === hovered;
        const r = radiusOf(node);

        ctx!.beginPath();
        ctx!.arc(node.x!, node.y!, active ? r + 2 : r, 0, Math.PI * 2);
        ctx!.fillStyle = node.type === 'source' ? colors.muted : colors.accent;
        ctx!.fill();

        if (node.focus) {
          // 중심 문서는 링으로 표시한다. 색만 바꾸면 타입 색과 헷갈린다.
          ctx!.beginPath();
          ctx!.arc(node.x!, node.y!, r + 4, 0, Math.PI * 2);
          ctx!.strokeStyle = colors.accent;
          ctx!.lineWidth = 1.5;
          ctx!.stroke();
        }

        ctx!.font = node.focus ? `600 ${LABEL_FONT}` : LABEL_FONT;
        ctx!.fillStyle = active || node.focus ? colors.text : colors.muted;
        ctx!.fillText(node.label ?? node.title, node.x!, node.y! + r + (node.focus ? 7 : 4));
      }
    }

    function nodeAt(event: PointerEvent): GraphNode | null {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      for (const node of nodes) {
        const r = radiusOf(node) + 6;
        if ((node.x! - x) ** 2 + (node.y! - y) ** 2 <= r * r) return node;
      }
      return null;
    }

    canvas.addEventListener('pointermove', (event) => {
      if (dragged) {
        const rect = canvas.getBoundingClientRect();
        dragged.fx = event.clientX - rect.left;
        dragged.fy = event.clientY - rect.top;
        dragMoved = true;
        simulation.alphaTarget(0.2).restart();
        return;
      }
      const next = nodeAt(event);
      if (next !== hovered) {
        hovered = next;
        canvas.style.cursor = next ? 'pointer' : 'grab';
        canvas.title = next ? next.title : '';
        render();
      }
    });

    canvas.addEventListener('pointerdown', (event) => {
      const node = nodeAt(event);
      if (!node) return;
      dragged = node;
      dragMoved = false;
      canvas.setPointerCapture(event.pointerId);
    });

    canvas.addEventListener('pointerup', (event) => {
      const node = dragged;
      const moved = dragMoved;
      if (node) {
        node.fx = null;
        node.fy = null;
        dragged = null;
        dragMoved = false;
        simulation.alphaTarget(0);
      }
      // 끌지 않고 눌렀다 뗀 경우만 이동으로 친다.
      if (moved) return;
      const target = nodeAt(event);
      if (target && (!node || node === target)) {
        window.location.href = `/wiki/${target.id}`;
      }
    });

    canvas.addEventListener('pointerleave', () => {
      hovered = null;
      render();
    });

    const toggle = canvas
      .closest('.graph')
      ?.querySelector<HTMLInputElement>('.graph__tags');

    toggle?.addEventListener('change', () => {
      showTags = toggle.checked;
      links = showTags ? allLinks : allLinks.filter((link) => link.kind !== 'tag');
      linkForce.links(links);
      simulation.alpha(0.6).restart();
    });

    new ResizeObserver(resize).observe(canvas);
    resize();
  }

  async function load(canvas: HTMLCanvasElement): Promise<Graph | null> {
    const inline = canvas.dataset.graph;
    if (inline) return JSON.parse(inline) as Graph;

    const src = canvas.dataset.graphSrc;
    if (!src) return null;
    try {
      const response = await fetch(src);
      return (await response.json()) as Graph;
    } catch {
      return null;
    }
  }
</script>
