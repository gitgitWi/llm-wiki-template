---
import Base from '../layouts/Base.astro';
import { buildGraph, getPublicDocs } from '../lib/wiki';

const docs = await getPublicDocs();
const { nodes, links } = buildGraph(docs);
const orphans = nodes.filter((node) => node.degree === 0);
---

<Base
  title="그래프"
  description="공개 문서 사이의 위키링크 연결 그래프."
  indexable={false}
>
  <h1 class="page-title">그래프</h1>
  <p class="lede">
    공개 문서 {nodes.length}개, 연결 {links.length}개. 본문의 <code>[[wikilink]]</code> 와
    frontmatter 의 <code>related:</code> 를 합쳐서 그린다. 비공개 문서는 노드로도 나오지 않는다.
  </p>

  <figure class="graph">
    <canvas id="graph-canvas" role="img" aria-label="문서 연결 그래프"></canvas>
    <figcaption class="card__meta">
      노드를 끌어 옮길 수 있다. 클릭하면 해당 문서로 이동한다.
    </figcaption>
  </figure>

  <noscript>
    <p class="empty">
      그래프는 스크립트로 그린다. <a href="/wiki/">문서 목록</a>에서 같은 내용을 볼 수 있다.
    </p>
  </noscript>

  {
    orphans.length > 0 && (
      <>
        <h2 class="section-title">연결이 없는 문서 · {orphans.length}</h2>
        <ul class="chips">
          {orphans.map((node) => (
            <li>
              <a class="chip" href={`/wiki/${node.id}`}>
                {node.title}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  .graph {
    margin: 0 0 1rem;
  }

  #graph-canvas {
    width: 100%;
    height: min(70vh, 34rem);
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    touch-action: none;
    cursor: grab;
  }

  #graph-canvas:active {
    cursor: grabbing;
  }

  figcaption {
    margin-top: 0.5rem;
  }
</style>

<script>
  import {
    forceCenter,
    forceCollide,
    forceLink,
    forceManyBody,
    forceSimulation,
  } from 'd3-force';

  type GraphNode = {
    id: string;
    title: string;
    type: string;
    degree: number;
    x?: number;
    y?: number;
    fx?: number | null;
    fy?: number | null;
  };
  type GraphLink = { source: GraphNode | string; target: GraphNode | string };

  const canvas = document.getElementById('graph-canvas') as HTMLCanvasElement | null;
  if (canvas) void draw(canvas);

  async function draw(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const response = await fetch('/graph.json');
    const { nodes, links } = (await response.json()) as {
      nodes: GraphNode[];
      links: GraphLink[];
    };
    if (nodes.length === 0) return;

    const css = getComputedStyle(document.documentElement);
    const colors = {
      text: css.getPropertyValue('--text').trim() || '#222',
      muted: css.getPropertyValue('--text-muted').trim() || '#888',
      accent: css.getPropertyValue('--accent').trim() || '#8a5a2b',
      border: css.getPropertyValue('--border').trim() || '#ddd',
    };

    let width = 0;
    let height = 0;
    let hovered: GraphNode | null = null;
    let dragged: GraphNode | null = null;

    const radiusOf = (node: GraphNode) => 5 + Math.min(node.degree, 6) * 1.6;

    const simulation = forceSimulation<GraphNode>(nodes)
      .force(
        'link',
        forceLink<GraphNode, GraphLink>(links)
          .id((node) => node.id)
          .distance(90)
          .strength(0.35),
      )
      .force('charge', forceManyBody().strength(-320))
      .force('collide', forceCollide<GraphNode>((node) => radiusOf(node) + 22))
      .on('tick', render);

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      simulation.force('center', forceCenter(width / 2, height / 2)).alpha(0.6).restart();
    }

    function render() {
      ctx!.clearRect(0, 0, width, height);

      ctx!.strokeStyle = colors.border;
      ctx!.lineWidth = 1;
      for (const link of links) {
        const source = link.source as GraphNode;
        const target = link.target as GraphNode;
        ctx!.beginPath();
        ctx!.moveTo(source.x!, source.y!);
        ctx!.lineTo(target.x!, target.y!);
        ctx!.stroke();
      }

      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'top';
      ctx!.font = '12px system-ui, sans-serif';
      for (const node of nodes) {
        const active = node === hovered;
        const r = radiusOf(node);

        ctx!.beginPath();
        ctx!.arc(node.x!, node.y!, active ? r + 2 : r, 0, Math.PI * 2);
        ctx!.fillStyle = node.type === 'source' ? colors.muted : colors.accent;
        ctx!.fill();

        ctx!.fillStyle = active ? colors.text : colors.muted;
        ctx!.fillText(truncate(node.title), node.x!, node.y! + r + 4);
      }
    }

    function truncate(label: string) {
      return label.length > 18 ? `${label.slice(0, 17)}…` : label;
    }

    function nodeAt(event: PointerEvent): GraphNode | null {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      for (const node of nodes) {
        const r = radiusOf(node) + 6;
        if ((node.x! - x) ** 2 + (node.y! - y) ** 2 <= r * r) return node;
      }
      return null;
    }

    canvas.addEventListener('pointermove', (event) => {
      if (dragged) {
        const rect = canvas.getBoundingClientRect();
        dragged.fx = event.clientX - rect.left;
        dragged.fy = event.clientY - rect.top;
        simulation.alphaTarget(0.2).restart();
        return;
      }
      const next = nodeAt(event);
      if (next !== hovered) {
        hovered = next;
        canvas.style.cursor = next ? 'pointer' : 'grab';
        canvas.title = next ? next.title : '';
        render();
      }
    });

    canvas.addEventListener('pointerdown', (event) => {
      const node = nodeAt(event);
      if (!node) return;
      dragged = node;
      canvas.setPointerCapture(event.pointerId);
    });

    canvas.addEventListener('pointerup', (event) => {
      const node = dragged;
      if (node) {
        node.fx = null;
        node.fy = null;
        dragged = null;
        simulation.alphaTarget(0);
      }
      // 끌지 않고 그냥 눌렀다 뗀 경우만 이동으로 친다.
      const target = nodeAt(event);
      if (target && (!node || node === target)) {
        window.location.href = `/wiki/${target.id}`;
      }
    });

    canvas.addEventListener('pointerleave', () => {
      hovered = null;
      render();
    });

    new ResizeObserver(resize).observe(canvas);
    resize();
  }
</script>
