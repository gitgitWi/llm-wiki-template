---
import { render } from 'astro:content';

import DocList from '../../components/DocList.astro';
import Base from '../../layouts/Base.astro';
import {
  DOMAIN_LABELS,
  TYPE_LABELS,
  backlinksOf,
  formatDate,
  getPublicDocs,
} from '../../lib/wiki';

/**
 * public 문서만 경로를 만든다.
 *
 * Workers Static Assets는 Worker보다 먼저 응답하므로, 여기서 만들어진 파일은
 * URL만 알면 인증 없이 받아진다. Phase 2에서 private 문서를 붙일 때 이 라우트에
 * 끼워 넣으면 안 되고, prerender하지 않는 별도 prefix로 분리해야 한다.
 */
export async function getStaticPaths() {
  const docs = await getPublicDocs();
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc, docs } }));
}

const { doc, docs } = Astro.props;
const { Content } = await render(doc);
const backlinks = backlinksOf(doc.id, docs).filter((other) => other.id !== doc.id);
const source = doc.data.source;
---

<Base title={doc.data.title} description={`${TYPE_LABELS[doc.data.type]} · ${doc.data.tags.join(', ')}`}>
  <article class="doc">
    <h1 class="page-title">{doc.data.title}</h1>

    <div class="doc__meta">
      <span>{TYPE_LABELS[doc.data.type]}</span>
      <span>·</span>
      <span>갱신 <time datetime={doc.data.updated.toISOString()}>{formatDate(doc.data.updated)}</time></span>
      {doc.data.status !== 'living' && <span>· {doc.data.status}</span>}
    </div>

    <ul class="chips" data-pagefind-ignore>
      {
        doc.data.domains.map((domain) => (
          <li>
            <a class="chip chip--domain" href={`/domains/${domain}`}>
              {DOMAIN_LABELS[domain]}
            </a>
          </li>
        ))
      }
      {
        doc.data.tags.map((tag) => (
          <li>
            <a class="chip" href={`/tags/${encodeURIComponent(tag)}`}>
              #{tag}
            </a>
          </li>
        ))
      }
    </ul>

    {
      source && (
        <aside class="doc__source" data-pagefind-ignore>
          <dl>
            {source.url && (
              <>
                <dt>원문</dt>
                <dd>
                  <a href={source.url} rel="noopener noreferrer nofollow" target="_blank">
                    {source.site ?? new URL(source.url).hostname}
                  </a>
                </dd>
              </>
            )}
            {source.author && (
              <>
                <dt>저자</dt>
                <dd>{source.author}</dd>
              </>
            )}
            {source.captured && (
              <>
                <dt>수집</dt>
                <dd>{formatDate(source.captured)}</dd>
              </>
            )}
            {doc.data.summary?.model && (
              <>
                <dt>요약</dt>
                <dd>{doc.data.summary.model}</dd>
              </>
            )}
          </dl>
        </aside>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    backlinks.length > 0 && (
      <section class="backlinks" data-pagefind-ignore>
        <h2 class="section-title">연결된 문서</h2>
        <DocList docs={backlinks} />
      </section>
    )
  }
</Base>
